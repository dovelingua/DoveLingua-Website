function setLang(l){lang=l;document.documentElement.lang=l;document.getElementById('btn-en').classList.toggle('active',l==='en');document.getElementById('btn-pt').classList.toggle('active',l==='pt');document.querySelectorAll('[data-en]').forEach(function(el){var v=el.getAttribute('data-'+l);if(v!==null)el.innerHTML=v;});localStorage.setItem('dvl_lang',l);}
function toggleMenu(){var m=document.getElementById('sM'),o=document.getElementById('sO');m.classList.toggle('open');o.classList.toggle('open');}
function nav(page){document.getElementById('sM').classList.remove('open');document.getElementById('sO').classList.remove('open');window.location.href=page;}
function initSlider(){var cards=document.querySelectorAll('.slide-card');total=cards.length;var dc=document.getElementById('sliderDots');for(var i=0;i<total;i++){var d=document.createElement('div');d.className='sdot'+(i===0?' active':'');d.setAttribute('data-i',i);d.onclick=function(){goSlide(parseInt(this.getAttribute('data-i')));};dc.appendChild(d);}setSlide(0);setInterval(function(){slideMove(1);},5500);}
function goSlide(n){si=n;setSlide(n);}
function slideMove(d){si=(si+d+total)%total;setSlide(si);}
function setSlide(n){document.getElementById('sliderTrack').style.transform='translateX(-'+(n*100)+'%)';document.querySelectorAll('.sdot').forEach(function(d,i){d.classList.toggle('active',i===n);});}
function handleSubscribe(){var name=document.getElementById('subName').value.trim();var wa=document.getElementById('subWA').value.trim();if(!name||!wa){alert(lang==='en'?'Please enter your name and WhatsApp number.':'Por favor, introduz o teu nome e número WhatsApp.');return;}document.getElementById('successNamePT').textContent=name;if(document.getElementById('successNameEN'))document.getElementById('successNameEN').textContent=name;document.getElementById('subFormWrap').style.display='none';document.getElementById('successCard').style.display='block';setLang(lang);}
window.addEventListener('load',function(){initSlider();setLang(lang);});
</script>
