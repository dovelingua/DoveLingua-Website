<style>
:root{
  --navy:#0B2E73;--navy-d:#082154;--gold:#C9971A;--white:#FFFFFF;
  --grey:#F4F4F4;--navy-tint:#E8EEF9;--teal:#0E8F7F;
  --text:#1a2332;--text-mid:#4a5568;--text-light:#718096;--border:#e2e8f0;
  --r:16px;--rsm:10px;--shadow:0 4px 20px rgba(11,46,115,0.08);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:'Inter',Arial,sans-serif;color:var(--text);background:var(--white);overflow-x:hidden;line-height:1.7;}
a{text-decoration:none;color:inherit;}
img{max-width:100%;height:auto;display:block;}

/* NAV */
nav{position:sticky;top:0;z-index:999;background:var(--white);border-bottom:1px solid var(--border);padding:0 clamp(1rem,4vw,2.5rem);height:66px;display:flex;align-items:center;justify-content:space-between;}
.nav-left{display:flex;align-items:center;gap:1rem;}
.hamburger{display:flex;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:4px;}
.hamburger span{display:block;width:22px;height:2px;background:var(--navy);border-radius:2px;}
.nav-brand{display:flex;align-items:center;height:38px;}
.nav-brand img{max-height:38px;width:auto;}
.nav-centre{display:flex;gap:.15rem;list-style:none;position:absolute;left:50%;transform:translateX(-50%);}
.nav-centre a{font-size:.82rem;font-weight:500;color:var(--text-mid);padding:.4rem .65rem;border-radius:6px;transition:.2s;}
.nav-centre a:hover,.nav-centre a.active{background:var(--navy-tint);color:var(--navy);}
.nav-right{display:flex;align-items:center;gap:.6rem;}
.lang-toggle{display:flex;border:1.5px solid var(--border);border-radius:20px;overflow:hidden;}
.lang-toggle button{border:none;background:transparent;padding:.3rem .75rem;cursor:pointer;color:var(--text-light);font-size:.72rem;font-weight:700;transition:.2s;}
.lang-toggle button.active{background:var(--navy);color:var(--white);}
.profile-icon{width:34px;height:34px;border-radius:50%;background:var(--navy-tint);border:1.5px solid var(--navy);display:flex;align-items:center;justify-content:center;font-size:1rem;transition:.2s;}
.profile-icon:hover{background:var(--navy);color:var(--white);}
.btn-enrol-nav{background:var(--navy);color:var(--white);border:1.5px solid var(--navy);padding:.42rem 1rem;border-radius:20px;font-size:.78rem;font-weight:600;white-space:nowrap;transition:.2s;}
.btn-enrol-nav:hover{background:var(--gold);border-color:var(--gold);color:var(--navy);}
@media(max-width:860px){.nav-centre,.btn-enrol-nav{display:none;}}
@media(max-width:400px){.nav-brand img{max-height:30px;}}

/* SIDE MENU */
.so{display:none;position:fixed;inset:0;background:rgba(11,46,115,.4);z-index:1100;}
.so.open{display:block;}
.sm{position:fixed;top:0;left:-290px;width:290px;height:100%;background:var(--white);z-index:1200;transition:left .3s ease;display:flex;flex-direction:column;}
.sm.open{left:0;}
@media(max-width:340px){.sm{width:100%;left:-100%;}}
.sm-hdr{background:linear-gradient(135deg,var(--navy),var(--navy-d));padding:1.4rem 1.1rem;display:flex;align-items:center;gap:.8rem;position:relative;}
.sm-cl{position:absolute;top:14px;right:14px;background:rgba(255,255,255,.15);border:none;color:var(--white);width:28px;height:28px;border-radius:50%;cursor:pointer;font-size:15px;}
.sm-hdr img{height:34px;}
.sm-nav{flex:1;overflow-y:auto;padding:.5rem 0;}
.sm-nav a{display:flex;align-items:center;gap:.75rem;padding:.75rem 1.2rem;font-size:.88rem;font-weight:500;color:var(--text-mid);cursor:pointer;transition:.15s;border-left:3px solid transparent;}
.sm-nav a:hover{background:var(--navy-tint);color:var(--navy);border-left-color:var(--gold);}
.mi{font-size:1rem;width:20px;text-align:center;}
.sdiv{height:1px;background:var(--border);margin:.4rem 1.2rem;}
.bsoon{background:var(--navy-tint);color:var(--navy);font-size:.62rem;font-weight:700;padding:.15rem .45rem;border-radius:8px;margin-left:auto;}
.sm-ft{padding:1rem 1.2rem;border-top:1px solid var(--border);background:var(--grey);}
.sm-ft p{font-style:italic;font-size:.75rem;color:var(--text-light);line-height:1.55;}

/* HERO */
.hero{background:linear-gradient(150deg,var(--navy-d) 0%,var(--navy) 55%,#123a8a 100%);padding:64px 5% 72px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;}
.hero-card{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);border-radius:20px;padding:36px 44px;max-width:640px;width:100%;backdrop-filter:blur(6px);border-top:4px solid var(--gold);}
.hero-card .academy-label{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:14px;display:block;}
.hero-card h1{font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,42px);font-weight:700;color:var(--white);line-height:1.2;margin-bottom:14px;}
.hero-card .slogan{font-size:clamp(13px,1.8vw,16px);color:var(--gold);line-height:1.6;font-weight:600;font-style:italic;margin-bottom:8px;}
.hero-card .slogan2{font-size:clamp(12px,1.6vw,15px);color:rgba(255,255,255,.75);line-height:1.6;font-weight:300;}
.hero-pills{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:28px;}
.hero-pill{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);padding:7px 16px;border-radius:30px;font-size:12px;font-weight:500;color:var(--white);}

.sec{padding:72px 5%;}
.sec.gw{background:var(--grey);}
.sec.tint{background:var(--navy-tint);}
.sec.wh{background:var(--white);}

.sh{margin-bottom:36px;}
.sh.c{text-align:center;}
.sh.c .ssub{margin:0 auto;}
.stag-head{display:inline-block;background:var(--navy);color:var(--white);font-family:'Playfair Display',serif;font-size:clamp(26px,3.2vw,40px);font-weight:700;padding:10px 28px;border-radius:12px;line-height:1.2;margin-bottom:10px;}
.sub-head{font-family:'Playfair Display',serif;font-size:clamp(18px,2.2vw,26px);font-weight:600;color:var(--navy);margin-bottom:10px;}
.ssub{font-size:14px;color:var(--text-mid);line-height:1.75;max-width:560px;}

/* SLIDER */
.slider-outer{max-width:800px;margin:0 auto;}
.slider-wrap{overflow:hidden;border-radius:var(--r);}
.slider-track{display:flex;transition:transform .5s cubic-bezier(.4,0,.2,1);}
.slide-card{min-width:100%;width:100%;background:var(--white);border:1px solid var(--border);border-radius:var(--r);padding:32px 28px;display:flex;flex-direction:column;align-items:center;text-align:center;flex-shrink:0;box-sizing:border-box;}
.slide-ico{width:56px;height:56px;border-radius:50%;background:var(--navy-tint);border:2px solid var(--gold);display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 18px;flex-shrink:0;}
.slide-body{width:100%;max-width:600px;}
.slide-body h3{font-family:'Playfair Display',serif;font-size:clamp(17px,2.2vw,22px);color:var(--navy);margin-bottom:10px;}
.slide-body p{font-size:14px;color:var(--text-mid);line-height:1.75;margin-bottom:20px;}
.slide-btn-wrap{display:flex;justify-content:flex-end;width:100%;}
.slide-btn{display:inline-flex;align-items:center;gap:6px;background:var(--navy);color:var(--white);padding:10px 22px;border-radius:30px;font-size:13px;font-weight:600;border:none;cursor:pointer;transition:.2s;}
.slide-btn:hover{background:var(--gold);color:var(--navy);}
.slider-ctrl{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:18px;}
.sarr{background:var(--navy);border:none;width:40px;height:40px;border-radius:50%;cursor:pointer;font-size:18px;color:var(--white);display:flex;align-items:center;justify-content:center;transition:.2s;box-shadow:0 2px 8px rgba(11,46,115,.3);}
.sarr:hover{background:var(--gold);color:var(--navy);transform:scale(1.08);}
.sdots{display:flex;gap:8px;}
.sdot{width:9px;height:9px;border-radius:50%;background:var(--border);cursor:pointer;transition:.2s;}
.sdot.active{background:var(--navy);}

.two-col{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;max-width:1200px;margin:0 auto;}
.col-vis{background:var(--navy-tint);border-radius:var(--r);aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;font-size:72px;border:1px solid var(--border);}
.story-blocks{display:flex;flex-direction:column;gap:14px;}
.story-block{background:var(--white);border-radius:var(--r);border:1px solid var(--border);border-left:4px solid var(--gold);padding:18px 20px;box-shadow:var(--shadow);}
.story-block h4{font-size:14px;font-weight:600;color:var(--navy);margin-bottom:6px;}
.story-block p{font-size:13px;color:var(--text-mid);line-height:1.7;text-align:justify;}
.right-btn{display:flex;justify-content:flex-end;margin-top:18px;}

.why-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;max-width:1200px;margin:0 auto;}
.why-card{background:var(--white);border-radius:var(--r);border:1px solid var(--border);padding:28px;text-align:center;transition:all .25s;box-shadow:var(--shadow);}
.why-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(11,46,115,.14);}
.why-ico{font-size:32px;margin-bottom:14px;}
.why-card h3{font-size:15px;font-weight:600;color:var(--navy);margin-bottom:8px;}
.why-card p{font-size:13px;color:var(--text-mid);line-height:1.7;text-align:justify;}

.comm-sec{background:linear-gradient(135deg,var(--navy-d),var(--navy) 60%,#123a8a);padding:80px 5%;text-align:center;}
.comm-sec h2{font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,46px);font-weight:700;color:var(--white);margin-bottom:16px;line-height:1.2;}
.comm-sec p{font-size:15px;color:rgba(255,255,255,.82);line-height:1.85;max-width:620px;margin:0 auto 40px;}
.quote-box{background:rgba(255,255,255,.08);border:1px solid var(--gold);border-radius:var(--r);padding:32px 40px;max-width:560px;margin:0 auto;position:relative;}
.quote-box::before{content:'"';font-family:'Playfair Display',serif;font-size:80px;color:rgba(201,151,26,.3);position:absolute;top:-10px;left:20px;line-height:1;}
.quote-box .qt{font-family:'Playfair Display',serif;font-size:clamp(18px,2.5vw,26px);font-style:italic;color:var(--gold);line-height:1.5;margin-bottom:14px;position:relative;z-index:1;}
.quote-box .qauth{font-size:13px;color:rgba(255,255,255,.65);font-weight:500;}

.lvl-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;max-width:1200px;margin:0 auto;}
.lvl-card{background:var(--white);border-radius:var(--r);border:1px solid var(--border);border-top:4px solid var(--navy);padding:22px 20px;transition:all .25s;box-shadow:var(--shadow);}
.lvl-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(11,46,115,.14);}
.lvl-card.l0{border-top-color:#6b7280;}
.lvl-card.l2{border-top-color:var(--teal);}
.lvl-card.l3{border-top-color:#2563eb;}
.lvl-card.l4{border-top-color:#7c3aed;}
.lvl-card.l5{border-top-color:var(--gold);}
.lvl-top{display:flex;flex-direction:column;align-items:center;margin-bottom:12px;}
.cefr-tag{display:inline-block;background:var(--navy);color:var(--white);font-size:12px;font-weight:700;padding:4px 14px;border-radius:12px;margin-bottom:4px;}
.lvl-card.l0 .cefr-tag{background:#6b7280;}
.lvl-card.l2 .cefr-tag{background:var(--teal);}
.lvl-card.l3 .cefr-tag{background:#2563eb;}
.lvl-card.l4 .cefr-tag{background:#7c3aed;}
.lvl-card.l5 .cefr-tag{background:var(--gold);color:var(--navy);}
.lvl-label{font-size:11px;color:var(--text-light);text-transform:uppercase;letter-spacing:.5px;}
.lvl-card h3{font-family:'Playfair Display',serif;font-size:17px;font-weight:700;color:var(--text);margin-bottom:4px;text-align:left;}
.lvl-card p{font-size:13px;color:var(--text-mid);line-height:1.65;margin-bottom:10px;text-align:justify;}
.lvl-goal{font-size:12px;color:var(--navy);font-weight:600;text-align:left;}

.how-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2px;background:var(--border);border-radius:var(--r);overflow:hidden;max-width:1200px;margin:0 auto;}
.how-step{background:var(--white);padding:36px 24px;text-align:center;transition:background .2s;}
.how-step:hover{background:var(--navy-tint);}
.how-num{width:48px;height:48px;border-radius:50%;background:var(--navy);color:var(--white);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:18px;font-weight:700;margin:0 auto 12px;}
.how-ico{font-size:26px;margin-bottom:10px;}
.how-step h3{font-size:15px;font-weight:600;color:var(--text);margin-bottom:8px;}
.how-step p{font-size:13px;color:var(--text-mid);line-height:1.65;}

.vm-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:1200px;margin:0 auto;}
.vm-card{background:var(--white);border-radius:var(--r);border:1px solid var(--border);padding:32px;text-align:center;box-shadow:var(--shadow);}
.vm-ico{font-size:26px;margin-bottom:10px;}
.vm-card h3{font-family:'Playfair Display',serif;font-size:20px;color:var(--navy);margin-bottom:10px;}
.vm-card p{font-size:14px;color:var(--text-mid);line-height:1.8;text-align:justify;}

.teacher-card{background:var(--white);border-radius:var(--r);border:1px solid var(--border);padding:40px 36px;text-align:center;max-width:1200px;margin:0 auto;box-shadow:var(--shadow);}
.t-av{width:90px;height:90px;border-radius:50%;object-fit:cover;margin:0 auto 14px;border:3px solid var(--gold);}
.t-name{font-family:'Playfair Display',serif;font-size:22px;color:var(--navy);margin-bottom:4px;}
.t-title{font-size:13px;color:var(--gold);font-weight:600;margin-bottom:16px;}
.t-info p{font-size:14px;color:var(--text-mid);line-height:1.75;max-width:680px;margin:0 auto 16px;text-align:justify;}
.t-badges{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;}
.t-badge{background:var(--navy-tint);border:1px solid var(--border);color:var(--navy);font-size:11px;font-weight:600;padding:4px 12px;border-radius:20px;}

.platform-card{background:linear-gradient(135deg,var(--navy-d),var(--navy) 60%,#123a8a);border-radius:var(--r);padding:52px 44px;color:var(--white);text-align:center;max-width:1200px;margin:0 auto;}
.platform-card .plat-sub{font-family:'Playfair Display',serif;font-size:clamp(16px,2.2vw,22px);margin-bottom:14px;opacity:.9;font-weight:400;color:var(--gold);}
.platform-card p{font-size:14px;opacity:.85;line-height:1.75;max-width:500px;margin:0 auto 28px;}
.plat-ico{font-size:56px;margin-bottom:16px;}

.t-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;max-width:1200px;margin:0 auto;}
.tcard{background:var(--white);border-radius:var(--r);border:1px solid var(--border);padding:26px;box-shadow:var(--shadow);}
.stars{color:var(--gold);font-size:13px;margin-bottom:12px;}
.tcard p{font-size:13px;color:var(--text-mid);line-height:1.75;font-style:italic;margin-bottom:16px;text-align:justify;}
.tauth{display:flex;align-items:center;gap:10px;}
.tav{width:34px;height:34px;border-radius:50%;background:var(--navy);display:flex;align-items:center;justify-content:center;color:var(--white);font-size:11px;font-weight:600;}
.tname{font-size:13px;font-weight:600;color:var(--text);}
.tlvl{font-size:11px;color:var(--text-light);}

.ac-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;max-width:1200px;margin:0 auto;}
.ac-card{border-radius:var(--r);border:1px solid var(--border);padding:32px 24px;transition:all .25s;text-align:center;}
.ac-card:hover{transform:translateY(-4px);}
.ac-card.gw{background:var(--navy-tint);}
.ac-card.dk{background:var(--navy);border-color:var(--navy);}
.ac-ico{font-size:36px;margin-bottom:14px;}
.ac-card h3{font-size:16px;font-weight:600;margin-bottom:8px;}
.ac-card.gw h3{color:var(--navy);}
.ac-card.dk h3{color:var(--gold);}
.ac-card p{font-size:13px;line-height:1.7;margin-bottom:22px;text-align:justify;}
.ac-card.gw p{color:var(--text-mid);}
.ac-card.dk p{color:rgba(255,255,255,.65);}

.sub-sec{background:var(--navy-tint);padding:72px 5%;text-align:center;}
.sub-sec .stag-head{font-size:clamp(28px,3.6vw,44px);}
.sub-sec p.sub-desc{font-size:14px;color:var(--text-mid);max-width:480px;margin:12px auto 28px;line-height:1.7;}
.sub-form{background:var(--white);border-radius:var(--r);border:1px solid var(--border);padding:32px;max-width:460px;margin:0 auto;display:flex;flex-direction:column;gap:12px;box-shadow:var(--shadow);}
.sub-form input{width:100%;padding:13px 16px;border:1.5px solid var(--border);border-radius:var(--rsm);font-size:14px;font-family:'Inter',sans-serif;color:var(--text);background:var(--grey);outline:none;transition:.2s;}
.sub-form input:focus{border-color:var(--navy);}
.sub-form input::placeholder{color:#94a3b8;}

.success-card{background:var(--white);border-radius:var(--r);border:1px solid var(--border);padding:40px 32px;max-width:460px;margin:0 auto;text-align:center;display:none;box-shadow:var(--shadow);}
.success-card .s-ico{font-size:52px;margin-bottom:16px;}
.success-card h3{font-family:'Playfair Display',serif;font-size:22px;color:var(--navy);margin-bottom:10px;}
.success-card p{font-size:14px;color:var(--text-mid);line-height:1.7;}
.success-card .s-name{font-weight:600;color:var(--gold);}

/* FOOTER */
footer{background:var(--navy);color:var(--white);padding:48px 5% 26px;}
.fg{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:32px;margin-bottom:32px;}
.fb .fname{font-family:'Playfair Display',serif;font-size:16px;font-weight:700;margin-bottom:10px;color:var(--white);}
.fb p{font-size:13px;color:rgba(255,255,255,.5);line-height:1.7;margin-bottom:16px;}
.fsoc{display:flex;gap:10px;}
.fsb{width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.2s;}
.fsb:hover{background:var(--gold);}
.fc h4{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--gold);margin-bottom:12px;}
.fc a{display:block;font-size:13px;color:rgba(255,255,255,.6);margin-bottom:8px;cursor:pointer;transition:.18s;}
.fc a:hover{color:var(--gold);}
.fbot{max-width:1100px;margin:0 auto;border-top:1px solid rgba(255,255,255,.1);padding-top:20px;display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:14px;text-align:center;}
